{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/*.svelte", "!apps/web/src/lib/assets/chatgpt-logo-white.svg", "!**/*.md", "!**/.svelte-kit", "!apps/web/**/*.{ts,js}"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  }
}
